{
  "name": "esplang-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "setup:toolchain": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-toolchain.ps1",
    "dev": "concurrently -k -n server,ide \"npm run dev -w @esplang/server\" \"npm run dev -w @esplang/web\"",
    "build": "npm run build -w @esplang/compiler && npm run build -w @esplang/server && npm run build -w @esplang/web",
    "typecheck": "tsc -p packages/compiler --noEmit && tsc -p packages/server --noEmit && tsc -p packages/web --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:smoke": "tsx scripts/smoke.ts",
    "test:firmware": "tsx scripts/smoke.ts --build",
    "start": "npm run start -w @esplang/server",
    "docs:assets": "node scripts/generate-readme-assets.mjs",
    "docs:record": "node scripts/record-readme-demo.mjs"
  },
  "overrides": {
    "vite": "6.4.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.18.6",
    "concurrently": "9.2.5",
    "gifenc": "1.0.3",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
